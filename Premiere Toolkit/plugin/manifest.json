{
  "manifestVersion": 5,
  "id": "com.eduardonoe.premieretoolkit",
  "name": "Premiere Toolkit",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "premiereToolkitPanel",
      "label": { "default": "Premiere Toolkit" },
      "minimumSize": { "width": 280, "height": 360 },
      "maximumSize": { "width": 1200, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 640 },
      "preferredFloatingSize": { "width": 380, "height": 720 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "extensions": [".bat"],
      "schemes": []
    }
  }
}

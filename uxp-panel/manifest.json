{
  "manifestVersion": 5,
  "id": "com.eduardonoe.premiere-motion-panel",
  "name": "Premiere Motion Panel",
  "version": "0.1.1",
  "main": "index.html",
  "host": [
    {
      "app": "PPRO",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "premiereMotionPanel",
      "label": {
        "default": "Premiere Motion"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 760
      }
    }
  ]
}
